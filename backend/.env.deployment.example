# Process variables in Render. Never commit filled values.
ATLAS_DEPLOYMENT=hosted
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=
ATLAS_CORS_ORIGINS=https://YOUR-PAGES-PROJECT.pages.dev
# Neon pooled URL, with verify-full and Render's Linux CA bundle; percent-encode credentials.
# The vendored psycopg/libpq OpenSSL defaults did not locate Render's CA trust store.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.neon.tech/neondb?sslmode=verify-full&sslrootcert=%2Fetc%2Fssl%2Fcerts%2Fca-certificates.crt&channel_binding=require
ATLAS_ASSESSMENT_ACCESS_HASH=
# Enable curated anonymous examples only with the public-access release approval.
ATLAS_PUBLIC_EXAMPLES_ENABLED=0
ATLAS_MAX_LOCAL_SNAPSHOTS=20
ATLAS_SNAPSHOT_RETENTION_HOURS=1
ATLAS_PROVIDER_TIMEOUT_SECONDS=12
ATLAS_ACQUISITION_SECONDS=100
ATLAS_LIVE_ENABLED=0
ATLAS_NONCOMMERCIAL_ASSESSMENT=1
ATLAS_ACCEPT_PROVIDER_SNOWFALL=1
# Change these only after the user confirms the intended public use/display scope.
ATLAS_PUBLIC_WEATHER_CONFIRMED=0
ATLAS_PUBLIC_TOMTOM_CONFIRMED=0
TOMTOM_API_KEY=
