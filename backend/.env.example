# Defaults remain local sample mode. Settings read process variables.
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,testserver
ATLAS_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
ATLAS_SNAPSHOT_RETENTION_HOURS=24
ATLAS_MAX_LOCAL_SNAPSHOTS=100
# Optional persistent secret for local development; generate a random value.
# DJANGO_SECRET_KEY=
# ATLAS_SQLITE_PATH=/absolute/local/path/atlas.sqlite3

# Optional personal noncommercial assessment mode. Keep credentials server-side.
ATLAS_LIVE_ENABLED=0
ATLAS_NONCOMMERCIAL_ASSESSMENT=0
ATLAS_ACCEPT_PROVIDER_SNOWFALL=0
# TOMTOM_API_KEY=
# ATLAS_PROVIDER_BUDGET_PATH=/absolute/private/local/provider-budget.json
# ATLAS_CA_BUNDLE=/absolute/path/to/trusted-ca-bundle.pem
# No VITE_* provider keys. No automatic retries, budget resets or paid fallback.
# Optional local PostgreSQL URL (not required for ordinary SQLite development).
# DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/atlas?sslmode=disable
# ATLAS_ASSESSMENT_ACCESS_HASH=
# Hosted configuration is separate: .env.deployment.example. All live public gates default off.
